# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Variables that Convex functions read must ALSO be set on the deployment with
# `npx convex env set <NAME> <value>` — the Next-side copy is not visible there.

# ── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# ── Clerk ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_FRONTEND_API_URL=
CLERK_WEBHOOK_SECRET=
CLERK_SYNC_TOKEN=

# ── Video pipeline (B2 raw upload → GitHub Actions HLS → Cloudflare CDN) ────
# Bare https origin of the B2 S3 endpoint. REQUIRED: `next build` fails in
# production when this is unset or carries a path/query/fragment. It is added
# to the page CSP so the browser may PUT multipart parts directly to B2.
NEXT_PUBLIC_B2_UPLOAD_ORIGIN=
# Bare https origin of the Cloudflare media Worker (e.g. https://cdn.example.com).
# Optional, but playback through the CDN needs it in connect-src/media-src.
NEXT_PUBLIC_CDN_ORIGIN=

# Convex-side only (`npx convex env set …`), read by convex/videoStorage.ts:
# B2_ENDPOINT / B2_REGION / B2_APP_KEY_ID / B2_APP_KEY / B2_RAW_BUCKET
# B2_* here must be the WRITE key scoped to the private `glypha-media` bucket.
# The Worker's READ-ONLY key belongs only in `wrangler secret put` — never here.

# ── Integrations ────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
RESEND_FROM=
UPLOADTHING_TOKEN=
VIDEO_PLAYBACK_SECRET=
APP_ORIGIN=
BANK_ENCRYPTION_KEY=
NOTIFY_RATE_LIMIT_TOKEN=
